            <div key={i} className="river-card river-card-accent" style={{ flex: '1 1 280px', maxWidth: 340, padding: '24px 20px', textAlign: 'left' }}>
              <div style={{ fontSize: '1.3rem', marginBottom: 10 }}>{p.i}</div>
              <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.9rem', fontWeight: 700, color: C.dark, letterSpacing: 2, textTransform: 'uppercase', marginBottom: 10 }}>{p.t}</div>
              <div style={{ fontSize: '0.73rem', color: '#555', lineHeight: 1.8 }}>{p.txt}</div>
            </div>
          ))}
        </div>

        {/* Autoridades */}
        <div style={{ textAlign: 'center', marginBottom: 20 }}>
          <div style={{ display: 'inline-block', background: C.red, color: '#fff', fontFamily: "'Roboto', sans-serif", fontSize: '0.55rem', fontWeight: 700, letterSpacing: 3, textTransform: 'uppercase', padding: '5px 16px', borderRadius: 2, marginBottom: 18 }}>Autoridades</div>
        </div>
        <div style={{ display: 'flex', gap: 14, flexWrap: 'wrap', justifyContent: 'center', marginBottom: 40 }}>
          {LEADERS.map((l, i) => {
            const on = sel === i;
            return (
              <div key={i} onClick={() => setSel(on ? null : i)} className="river-card"
                style={{ background: on ? C.red : '#fff', color: on ? '#fff' : C.dark, borderRadius: 4, padding: '20px 28px', textAlign: 'center', minWidth: 160, cursor: 'pointer', transition: 'all 0.2s', border: on ? `1px solid ${C.red}` : '1px solid #e8e8e8' }}>
                <div style={{ width: 44, height: 44, borderRadius: '50%', background: on ? 'rgba(255,255,255,0.2)' : C.red, display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 10px', fontFamily: "'Oswald', sans-serif", fontSize: '0.78rem', fontWeight: 700, color: '#fff' }}>{initials(l.name)}</div>
                <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.85rem', fontWeight: 600, letterSpacing: 1, textTransform: 'uppercase' }}>{l.name}</div>
                <div style={{ fontSize: '0.6rem', fontWeight: 500, letterSpacing: 1.5, textTransform: 'uppercase', opacity: 0.6, marginTop: 4 }}>{l.role}</div>
              </div>
            );
