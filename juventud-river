const HAS_SB = Boolean(window.SUPABASE_URL && window.SUPABASE_KEY);
const LS_KEY = 'cj_river_v2';
const SB_API = window.SUPABASE_URL + '/rest/v1';
const SB_HDR = {
  'apikey': window.SUPABASE_KEY,
  'Authorization': 'Bearer ' + window.SUPABASE_KEY,
  'Content-Type': 'application/json',
  'Prefer': 'return=representation',
};

async function sbFetch(path, opts = {}) {
  const res = await fetch(SB_API + path, { ...opts, headers: { ...SB_HDR, ...(opts.headers || {}) } });
  if (!res.ok) { const txt = await res.text(); throw new Error(txt); }
  const txt = await res.text();
  return txt ? JSON.parse(txt) : null;
}

async function dbLoad() {
  if (HAS_SB) {
    const [evs, ns] = await Promise.all([
      sbFetch('/events?select=*&order=date.asc,time.asc'),
      sbFetch('/event_notes?select=*'),
    ]);
    const notes = {};
    (ns || []).forEach(n => { notes[n.event_id] = { id: n.id, content: n.content }; });
    return { events: evs || [], notes };
  }
  const saved = localStorage.getItem(LS_KEY);
  return saved ? JSON.parse(saved) : { events: DEFAULT_EVENTS, notes: {} };
}
function lsSave(events, notes) { localStorage.setItem(LS_KEY, JSON.stringify({ events, notes })); }
async function dbAddEvent(payload) {
  if (HAS_SB) { const data = await sbFetch('/events', { method: 'POST', body: JSON.stringify(payload) }); return Array.isArray(data) ? data[0] : data; }
  return { ...payload, id: `ev_${Date.now()}` };
}
async function dbRemoveEvent(id) { if (HAS_SB) await sbFetch(`/events?id=eq.${id}`, { method: 'DELETE' }); }
async function dbSaveNote(eventId, content, existing) {
  if (HAS_SB) {
    if (existing?.id) await sbFetch(`/event_notes?id=eq.${existing.id}`, { method: 'PATCH', body: JSON.stringify({ content }) });
    else await sbFetch('/event_notes', { method: 'POST', body: JSON.stringify({ event_id: eventId, content }) });
  }
}

