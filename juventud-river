        </div>

        {/* Bloque descriptivo */}
        <div style={{ background: C.dark, borderRadius: 4, padding: '28px 28px 28px 32px', color: '#fff', position: 'relative', overflow: 'hidden', maxWidth: 760, margin: '0 auto' }}>
          <div style={{ position: 'absolute', top: 0, left: 0, width: 4, height: '100%', background: C.red }} />
          <div className="river-stripes" style={{ opacity: 0.03 }} />
          <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.92rem', fontWeight: 700, letterSpacing: 2, textTransform: 'uppercase', marginBottom: 14, position: 'relative' }}>
            Sobre la <span style={{ color: C.red }}>Comisión</span>
          </div>
          <div style={{ fontSize: '0.78rem', lineHeight: 1.9, opacity: 0.72, position: 'relative' }}>
            La Comisión de la Juventud de River Plate nace con el propósito de dar voz, espacio y protagonismo a los socios jóvenes del club.<br /><br />
            Buscamos generar un punto de encuentro donde la formación, la participación y la comunidad se integren de manera natural, a través de charlas, experiencias y actividades que inspiren y conecten.<br /><br />
            Trabajamos sobre tres ejes principales — <span style={{ color: C.red, fontWeight: 600 }}>formativo</span>, <span style={{ color: '#aaa', fontWeight: 600 }}>sociocultural</span> y <span style={{ color: '#4FC3F7', fontWeight: 600 }}>deportivo</span> — con el objetivo de acompañar el desarrollo integral de los jóvenes, fortaleciendo su vínculo con el club y entre ellos.<br /><br />
            Creemos en una juventud activa, con iniciativa, que no solo participa, sino que también construye, propone y deja huella en la vida institucional de River.
          </div>
        </div>
      </div>
    </section>
  );
}

// ═══ MODAL ═══
function EventModal({ day, month, year, events, onClose, onAdd, onRemove }) {
  const [showForm, setShowForm] = useState(false);
  const [saving, setSaving]     = useState(false);
  const [form, setForm]         = useState({ title: '', time: '18:00', area: 'formativa', location: '', desc: '' });
  const dk  = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
  const evs = events.filter(e => e.date === dk);
  const iS  = { background: '#F4F4F4', border: '1px solid #ddd', borderRadius: 3, padding: '11px 13px', fontFamily: "'Roboto', sans-serif", fontSize: '16px', outline: 'none', width: '100%', color: C.dark };

  const handleAdd = async () => {
    if (!form.title.trim()) return;
    setSaving(true);
    try {
      await onAdd({ date: dk, title: form.title.trim(), time: form.time, area: form.area, location: form.location.trim() || null, description: form.desc.trim() || null });
      setForm({ title: '', time: '18:00', area: 'formativa', location: '', desc: '' });
      setShowForm(false);
    } finally { setSaving(false); }
  };

  return (
    <div onClick={onClose} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.55)', zIndex: 200, display: 'flex', alignItems: 'flex-end', justifyContent: 'center' }}>
      <div onClick={e => e.stopPropagation()} style={{ background: '#fff', borderRadius: '12px 12px 0 0', padding: '20px 18px 32px', width: '100%', maxWidth: 500, maxHeight: '88vh', overflowY: 'auto', boxShadow: '0 -8px 40px rgba(0,0,0,0.2)' }}>
        <div style={{ width: 36, height: 3, background: '#ddd', borderRadius: 2, margin: '0 auto 16px' }} />
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 16, borderBottom: '1px solid #eee', paddingBottom: 14 }}>
          <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '1.1rem', fontWeight: 700, color: C.dark, letterSpacing: 1 }}>{day} de {MONTHS[month]} <span style={{ color: C.red }}>{year}</span></div>
          <button onClick={onClose} style={{ background: '#F4F4F4', border: 'none', width: 30, height: 30, borderRadius: '50%', fontSize: '0.9rem', cursor: 'pointer', color: '#888', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>✕</button>
        </div>

        {evs.length === 0 && !showForm && <div style={{ color: '#888', fontSize: '0.82rem', textAlign: 'center', padding: '18px 0' }}>No hay eventos este día.</div>}
        {evs.map(ev => (
          <div key={ev.id} style={{ background: '#F9F9F9', borderRadius: 4, padding: '12px 14px', marginBottom: 8, borderLeft: `4px solid ${areaColor(ev.area)}`, position: 'relative', border: '1px solid #eee', borderLeftWidth: 4 }}>
            <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.9rem', fontWeight: 600, color: C.dark, paddingRight: 28 }}>{ev.title}</div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 7, marginTop: 4, flexWrap: 'wrap' }}>
              <span style={{ fontSize: '0.68rem', color: '#888' }}>{ev.time} hs</span>
              {ev.location && <span style={{ fontSize: '0.65rem', color: '#888' }}>📍 {ev.location}</span>}
              <span style={{ fontSize: '0.56rem', fontWeight: 700, color: '#fff', background: areaColor(ev.area), padding: '2px 8px', borderRadius: 2, fontFamily: "'Roboto', sans-serif", letterSpacing: 1, textTransform: 'uppercase' }}>{areaName(ev.area)}</span>
            </div>
            {ev.description && <div style={{ fontSize: '0.72rem', color: C.dark, marginTop: 5, opacity: 0.55 }}>{ev.description}</div>}
            <button onClick={() => onRemove(ev.id)} style={{ position: 'absolute', top: 8, right: 10, background: 'none', border: 'none', cursor: 'pointer', color: '#ccc', fontSize: 20, lineHeight: 1 }}>×</button>
          </div>
        ))}

        {!showForm ? (
          <button onClick={() => setShowForm(true)} className="btn-river" style={{ width: '100%', marginTop: 6, padding: '13px' }}>+ Agregar Evento</button>
        ) : (
          <div style={{ background: '#F9F9F9', borderRadius: 6, padding: 16, marginTop: 10, border: '1px solid #eee' }}>
            <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.7rem', fontWeight: 700, letterSpacing: 2, textTransform: 'uppercase', color: C.dark, marginBottom: 12 }}>Nuevo Evento</div>
            <input value={form.title} onChange={e => setForm(f => ({ ...f, title: e.target.value }))} placeholder="Nombre del evento *" style={iS} autoFocus />
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8, marginTop: 8 }}>
              <div>
                <div style={{ fontSize: '0.65rem', color: '#888', marginBottom: 4, fontWeight: 600, textTransform: 'uppercase', letterSpacing: 0.5 }}>Hora</div>
                <input type="time" value={form.time} onChange={e => setForm(f => ({ ...f, time: e.target.value }))} style={iS} />
              </div>
              <div>
                <div style={{ fontSize: '0.65rem', color: '#888', marginBottom: 4, fontWeight: 600, textTransform: 'uppercase', letterSpacing: 0.5 }}>Lugar (opcional)</div>
                <input value={form.location} onChange={e => setForm(f => ({ ...f, location: e.target.value }))} placeholder="Ej: Salón Principal" style={iS} />
              </div>
            </div>
            <div style={{ marginTop: 10 }}>
              <div style={{ fontSize: '0.65rem', color: '#888', marginBottom: 6, fontWeight: 600, textTransform: 'uppercase', letterSpacing: 0.5 }}>Área</div>
              <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                {AREAS.map(a => (
                  <button key={a.id} onClick={() => setForm(f => ({ ...f, area: a.id }))}
                    style={{ background: form.area === a.id ? a.color : 'transparent', color: form.area === a.id ? '#fff' : a.color, border: `1.5px solid ${a.color}`, padding: '5px 12px', borderRadius: 2, cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.64rem', fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase' }}>
                    {a.name}
                  </button>
                ))}
              </div>
            </div>
            <textarea value={form.desc} onChange={e => setForm(f => ({ ...f, desc: e.target.value }))} placeholder="Descripción (opcional)" rows={2} style={{ ...iS, marginTop: 8, resize: 'vertical' }} />
            <div style={{ display: 'flex', gap: 8, marginTop: 12 }}>
              <button onClick={handleAdd} disabled={saving || !form.title.trim()} className="btn-river" style={{ flex: 1, padding: '12px', opacity: saving || !form.title.trim() ? 0.5 : 1 }}>{saving ? 'Guardando...' : 'Guardar'}</button>
              <button onClick={() => setShowForm(false)} style={{ flex: 1, background: '#fff', color: C.dark, border: '1px solid #ddd', borderRadius: 2, padding: '12px', cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.75rem', fontWeight: 600 }}>Cancelar</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

// ═══ CALENDARIO ═══
function Cal({ events, addEvent, removeEvent }) {
  const today = new Date();
  const [vy, setVy]         = useState(today.getFullYear());
  const [vm, setVm]         = useState(today.getMonth());
  const [sel, setSel]       = useState(null);
  const [filter, setFilter] = useState('todas');
  const [mob, setMob]       = useState(window.innerWidth < 640);
  useEffect(() => { const h = () => setMob(window.innerWidth < 640); window.addEventListener('resize', h); return () => window.removeEventListener('resize', h); }, []);

  const pm = () => { if (vm === 0) { setVm(11); setVy(y => y - 1); } else setVm(m => m - 1); };
  const nm = () => { if (vm === 11) { setVm(0); setVy(y => y + 1); } else setVm(m => m + 1); };
  const isCurrentMonth = vy === today.getFullYear() && vm === today.getMonth();

  const fd = new Date(vy, vm, 1);
  let offset = fd.getDay() - 1; if (offset < 0) offset = 6;
  const dim = new Date(vy, vm + 1, 0).getDate();
  const cells = [];
  for (let i = 0; i < offset; i++) cells.push(null);
  for (let d = 1; d <= dim; d++) cells.push(d);

  const dk = (d) => `${vy}-${String(vm + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  const fe = filter === 'todas' ? events : events.filter(e => e.area === filter);
  const evOnDay = (d) => fe.filter(e => e.date === dk(d));
  const isToday = (d) => d === today.getDate() && vm === today.getMonth() && vy === today.getFullYear();

  return (
    <section id="calendario" className="section-gray" style={{ padding: mob ? '20px 0 28px' : '48px 0 56px', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
      <div style={{ padding: '0 16px', width: '100%', maxWidth: 1200, display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
        {!mob && (
          <div style={{ textAlign: 'center', marginBottom: 24 }}>
            <div className="section-label">Charlas & Eventos</div>
            <h2 className="section-title">Calen<span style={{ color: C.red }}>dario</span></h2>
            <div className="section-divider" />
          </div>
        )}
        {mob && <h2 style={{ fontFamily: "'Oswald', sans-serif", fontSize: '1.25rem', fontWeight: 700, textTransform: 'uppercase', letterSpacing: 2, color: C.dark, marginBottom: 10 }}>Calen<span style={{ color: C.red }}>dario</span></h2>}

        {/* Filtros */}
        <div style={{ display: 'flex', gap: 6, marginBottom: mob ? 10 : 16, flexWrap: mob ? 'nowrap' : 'wrap', justifyContent: mob ? 'flex-start' : 'center', overflowX: mob ? 'auto' : 'visible', width: '100%', WebkitOverflowScrolling: 'touch', paddingBottom: mob ? 2 : 0 }}>
          <button onClick={() => setFilter('todas')}
            style={{ background: filter === 'todas' ? C.dark : '#fff', color: filter === 'todas' ? '#fff' : '#555', border: `1px solid ${filter === 'todas' ? C.dark : '#ddd'}`, padding: mob ? '6px 14px' : '5px 14px', borderRadius: 2, cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.64rem', fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase', whiteSpace: 'nowrap', flexShrink: 0 }}>Todas</button>
          {AREAS.map(a => (
            <button key={a.id} onClick={() => setFilter(a.id)}
              style={{ background: filter === a.id ? a.color : '#fff', color: filter === a.id ? '#fff' : a.color, border: `1px solid ${filter === a.id ? a.color : a.color + '66'}`, padding: mob ? '6px 14px' : '5px 14px', borderRadius: 2, cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.64rem', fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase', whiteSpace: 'nowrap', flexShrink: 0 }}>{a.name}</button>
          ))}
        </div>

        {/* Navegación de mes */}
        <div style={{ width: '100%', display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12 }}>
          <button onClick={pm} style={{ background: '#fff', border: '1px solid #ddd', borderRadius: 2, width: 38, height: 38, cursor: 'pointer', fontSize: '1.1rem', color: '#555', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>‹</button>
          <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
            <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: 'clamp(0.95rem,3.5vw,1.3rem)', fontWeight: 700, letterSpacing: 3, textTransform: 'uppercase', color: C.dark }}>{MONTHS[vm]} <span style={{ color: C.red }}>{vy}</span></div>
            {!isCurrentMonth && (
              <button onClick={() => { setVy(today.getFullYear()); setVm(today.getMonth()); }}
                style={{ background: '#fff', color: C.red, border: `1px solid ${C.red}`, borderRadius: 2, padding: '3px 10px', cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.6rem', fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase' }}>Hoy</button>
            )}
          </div>
          <button onClick={nm} style={{ background: '#fff', border: '1px solid #ddd', borderRadius: 2, width: 38, height: 38, cursor: 'pointer', fontSize: '1.1rem', color: '#555', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>›</button>
        </div>
      </div>

      {/* Grid calendario */}
      <div style={{ width: '100%', maxWidth: 1200, padding: '0 4px' }}>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: mob ? 1 : 2, marginBottom: 2, padding: '0 4px' }}>
          {(mob ? DAYS_S : DAYS_F).map(d => (
            <div key={d} style={{ textAlign: 'center', fontFamily: "'Roboto', sans-serif", fontSize: mob ? '0.6rem' : '0.7rem', fontWeight: 700, letterSpacing: 1, color: '#999', textTransform: 'uppercase', padding: '6px 0', background: '#fff', borderBottom: '2px solid #eee' }}>{d}</div>
          ))}
        </div>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: mob ? 1 : 2, padding: '0 4px' }}>
          {cells.map((day, idx) => {
            if (day === null) return <div key={`e${idx}`} style={{ background: '#F9F9F9', minHeight: mob ? 44 : 100 }} />;
            const devs   = evOnDay(day);
            const today_ = isToday(day);
            return (
              <button key={idx} onClick={() => setSel(day)}
                style={{ background: today_ ? '#FFF0F0' : '#fff', border: today_ ? `1.5px solid ${C.red}` : '1px solid #eee', padding: mob ? '4px 3px 3px' : '6px 7px', cursor: 'pointer', minHeight: mob ? 44 : 100, display: 'flex', flexDirection: 'column', alignItems: 'stretch', textAlign: 'left', transition: 'background 0.1s' }}>
                {mob ? (
                  <>
                    <span style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.82rem', fontWeight: today_ ? 800 : 500, color: today_ ? C.red : devs.length > 0 ? '#1a1a1a' : '#aaa', lineHeight: 1, paddingLeft: 2 }}>{day}</span>
                    {devs.length > 0 && (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 2, marginTop: 'auto', paddingTop: 3 }}>
                        {devs.slice(0, 3).map(ev => (
                          <div key={ev.id} style={{ height: 4, borderRadius: 0, background: areaColor(ev.area) }} />
                        ))}
                        {devs.length > 3 && <div style={{ height: 3, background: '#ddd' }} />}
                      </div>
                    )}
                  </>
                ) : (
                  <>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 3 }}>
                      <span style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.95rem', fontWeight: today_ ? 800 : 600, color: today_ ? C.red : '#555' }}>{day}</span>
                      {devs.length > 0 && <span style={{ fontSize: '0.48rem', fontWeight: 700, color: C.red, background: '#FFF0F0', padding: '1px 5px', borderRadius: 2 }}>{devs.length}</span>}
                    </div>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: 2, flex: 1, overflow: 'hidden' }}>
                      {devs.slice(0, 3).map(ev => (
                        <div key={ev.id} style={{ background: areaColor(ev.area), borderRadius: 0, padding: '2px 5px', fontSize: '0.56rem', fontWeight: 600, color: '#fff', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{ev.title}</div>
                      ))}
                      {devs.length > 3 && <div style={{ fontSize: '0.46rem', color: '#aaa', fontWeight: 600, paddingLeft: 3 }}>+{devs.length - 3}</div>}
                    </div>
                  </>
                )}
              </button>
            );
          })}
        </div>
      </div>

      {/* Próximos eventos */}
      {(() => {
        const todayStr = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
        const upcoming = events.filter(e => e.date >= todayStr).sort((a,b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time)).slice(0, mob ? 3 : 4);
        if (upcoming.length === 0) return null;
        const MN = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
        return (
          <div style={{ width:'100%', maxWidth:1200, padding: mob ? '14px 12px 0' : '20px 16px 0' }}>
            <div style={{ fontFamily:"'Roboto',sans-serif", fontSize:'0.55rem', fontWeight:700, letterSpacing:3, textTransform:'uppercase', color:'#aaa', marginBottom: mob ? 8 : 12 }}>Próximos Eventos</div>
            <div style={{ display:'flex', flexDirection:'column', gap: mob ? 5 : 6 }}>
              {upcoming.map(ev => {
                const [,mm,dd] = ev.date.split('-');
                return (
                  <div key={ev.id} style={{ display:'flex', alignItems:'center', gap: mob ? 10 : 12, background:'#fff', borderRadius:2, padding: mob ? '9px 10px' : '11px 14px', borderLeft:`4px solid ${areaColor(ev.area)}`, border: '1px solid #eee', borderLeftWidth: 4 }}>
                    <div style={{ textAlign:'center', minWidth: mob ? 32 : 38, flexShrink:0 }}>
                      <div style={{ fontFamily:"'Oswald',sans-serif", fontSize: mob ? '0.95rem' : '1.1rem', fontWeight:800, color:C.dark, lineHeight:1 }}>{dd}</div>
                      <div style={{ fontFamily:"'Oswald',sans-serif", fontSize:'0.44rem', fontWeight:700, letterSpacing:2, color:'#aaa', textTransform:'uppercase' }}>{MN[parseInt(mm)-1]}</div>
                    </div>
                    <div style={{ flex:1, minWidth:0 }}>
                      <div style={{ fontFamily:"'Oswald',sans-serif", fontSize: mob ? '0.78rem' : '0.82rem', fontWeight:600, color:C.dark, whiteSpace:'nowrap', overflow:'hidden', textOverflow:'ellipsis' }}>{ev.title}</div>
                      <div style={{ display:'flex', gap:6, alignItems:'center', marginTop:2 }}>
                        <span style={{ fontSize:'0.58rem', color:'#aaa' }}>{ev.time} hs</span>
                        {ev.location && <span style={{ fontSize:'0.56rem', color:'#bbb', overflow:'hidden', textOverflow:'ellipsis', whiteSpace:'nowrap' }}>· {ev.location}</span>}
                      </div>
                    </div>
                    <span style={{ fontSize:'0.52rem', fontWeight:700, color:'#fff', background:areaColor(ev.area), padding:'3px 8px', borderRadius:2, fontFamily:"'Roboto',sans-serif", letterSpacing:1, textTransform:'uppercase', whiteSpace:'nowrap', flexShrink:0 }}>{areaName(ev.area)}</span>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })()}

      {sel !== null && (
        <EventModal day={sel} month={vm} year={vy} events={fe} onClose={() => setSel(null)} onAdd={async (p) => { await addEvent(p); }} onRemove={async (id) => { await removeEvent(id); }} />
      )}
    </section>
  );
}

// ═══ EDITOR DE NOTAS ═══
function NE({ eventId, note, onSave }) {
  const [ed, setEd]     = useState(false);
  const [draft, setDr]  = useState(note?.content ?? '');
  const [saving, setSv] = useState(false);
  const doSave = async () => { setSv(true); try { await onSave(eventId, draft); setEd(false); } finally { setSv(false); } };
  if (ed) return (
    <div>
      <textarea value={draft} onChange={e => setDr(e.target.value)} placeholder="¿Qué aprendimos?" rows={3}
        style={{ width: '100%', background: '#F4F4F4', border: '1px solid #ddd', borderRadius: 3, padding: '10px 12px', fontFamily: "'Roboto', sans-serif", fontSize: '16px', color: C.dark, outline: 'none', resize: 'vertical', lineHeight: 1.6 }} autoFocus />
      <div style={{ display: 'flex', gap: 8, marginTop: 8 }}>
        <button onClick={doSave} disabled={saving} className="btn-river" style={{ padding: '7px 16px', fontSize: '0.68rem', opacity: saving ? 0.5 : 1 }}>{saving ? '...' : 'Guardar'}</button>
        <button onClick={() => setEd(false)} style={{ background: '#F4F4F4', color: C.dark, border: '1px solid #ddd', borderRadius: 2, padding: '7px 14px', cursor: 'pointer', fontFamily: "'Roboto', sans-serif", fontSize: '0.68rem', fontWeight: 600 }}>Cancelar</button>
      </div>
    </div>
  );
  return (
    <div onClick={() => { setDr(note?.content ?? ''); setEd(true); }} style={{ cursor: 'pointer' }}>
      {note?.content
        ? <div style={{ fontSize: '0.75rem', color: C.dark, lineHeight: 1.7, background: '#F4F4F4', borderRadius: 2, padding: '9px 12px' }}>{note.content}<div style={{ fontSize: '0.6rem', color: '#aaa', marginTop: 4, fontStyle: 'italic' }}>Tocá para editar</div></div>
        : <div style={{ fontSize: '0.72rem', color: '#bbb', fontStyle: 'italic', background: '#F9F9F9', borderRadius: 2, padding: '9px 12px', border: '1px dashed #ddd' }}>Tocá para agregar notas...</div>
      }
    </div>
  );
}

// ═══ ÁREAS ═══
function Areas({ events, notes, saveNote }) {
  const [open, setOpen] = useState(null);
  return (
    <section id="areas" className="section-light" style={{ padding: '52px 16px 64px', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
      <div style={{ textAlign: 'center', marginBottom: 10 }}>
        <div className="section-label">Nuestro Trabajo</div>
        <h2 className="section-title">Áre<span style={{ color: C.red }}>as</span></h2>
        <div className="section-divider" />
      </div>
      <p style={{ fontSize: '0.72rem', color: '#888', marginBottom: 28, textAlign: 'center', maxWidth: 460 }}>Eventos agrupados por área. Editá las notas después de cada reunión.</p>
      <div style={{ width: '100%', maxWidth: 900, display: 'flex', flexDirection: 'column', gap: 10 }}>
        {AREAS.map(area => {
          const ae = events.filter(e => e.area === area.id).sort((a, b) => b.date.localeCompare(a.date));
          const io = open === area.id;
          return (
            <div key={area.id} style={{ borderRadius: 0, overflow: 'hidden', border: '1px solid #e0e0e0', boxShadow: io ? '0 4px 16px rgba(0,0,0,0.07)' : 'none' }}>
              <div onClick={() => setOpen(io ? null : area.id)}
                style={{ background: area.color, padding: '15px 18px', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'space-between', userSelect: 'none' }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                  <span style={{ fontSize: '0.9rem' }}>{area.icon}</span>
                  <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: 'clamp(0.82rem,3vw,1rem)', fontWeight: 700, color: '#fff', letterSpacing: 2, textTransform: 'uppercase' }}>{area.name}</div>
                </div>
                <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                  <span style={{ background: 'rgba(255,255,255,0.25)', color: '#fff', fontFamily: "'Roboto', sans-serif", fontSize: '0.64rem', fontWeight: 700, padding: '2px 9px', borderRadius: 2 }}>{ae.length}</span>
                  <span style={{ color: '#fff', fontSize: '0.9rem', transition: 'transform 0.2s', transform: io ? 'rotate(180deg)' : 'rotate(0deg)', display: 'inline-block' }}>▾</span>
                </div>
              </div>
              {io && (
                <div style={{ background: '#fff', padding: '14px 16px 18px' }}>
                  {ae.length === 0
                    ? <div style={{ color: '#aaa', fontSize: '0.78rem', padding: '14px 0', textAlign: 'center' }}>No hay eventos. Agregá uno desde el calendario.</div>
                    : ae.map((ev, i) => (
                      <div key={ev.id} style={{ background: '#F9F9F9', borderRadius: 0, padding: '14px', marginBottom: i < ae.length - 1 ? 8 : 0, borderLeft: `4px solid ${areaColor(ev.area)}`, border: '1px solid #eee', borderLeftWidth: 4 }}>
                        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 4, flexWrap: 'wrap', gap: 4 }}>
                          <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.84rem', fontWeight: 600, color: C.dark }}>{ev.title}</div>
                          <div style={{ fontSize: '0.62rem', color: '#aaa' }}>{ev.date.split('-').reverse().join('/')} · {ev.time}{ev.location ? ` · 📍 ${ev.location}` : ''}</div>
                        </div>
                        {ev.description && <div style={{ fontSize: '0.7rem', color: '#888', marginBottom: 7 }}>{ev.description}</div>}
                        <div style={{ marginTop: 7, borderTop: '1px solid #eee', paddingTop: 8 }}>
                          <div style={{ fontSize: '0.56rem', fontWeight: 700, color: areaColor(ev.area), fontFamily: "'Roboto', sans-serif", letterSpacing: 1.5, textTransform: 'uppercase', marginBottom: 5 }}>Notas</div>
                          <NE eventId={ev.id} note={notes[ev.id]} onSave={saveNote} />
                        </div>
                      </div>
                    ))
                  }
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  );
}

// ═══ FOOTER ═══
