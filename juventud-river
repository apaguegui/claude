  return (
    <footer style={{ background: C.dark, padding: '36px 20px 32px' }}>
      <div style={{ maxWidth: 1100, margin: '0 auto' }}>
        {/* Franja roja superior */}
        <div style={{ height: 3, background: C.red, marginBottom: 28, borderRadius: 1 }} />
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 16 }}>
          <div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 8 }}>
              <div style={{ width: 38, height: 38, borderRadius: '50%', background: C.red, display: 'flex', alignItems: 'center', justifyContent: 'center', fontFamily: "'Oswald', sans-serif", fontWeight: 800, fontSize: '0.72rem', color: '#fff' }}>CJ</div>
              <div>
                <div style={{ fontFamily: "'Oswald', sans-serif", fontSize: '0.88rem', fontWeight: 700, letterSpacing: 2, textTransform: 'uppercase', color: '#fff' }}>Comisión de la <span style={{ color: C.red }}>Juventud</span></div>
                <div style={{ fontSize: '0.58rem', color: 'rgba(255,255,255,0.3)', letterSpacing: 2 }}>Club Atlético River Plate · 2026</div>
              </div>
            </div>
          </div>
          <button onClick={onShare} className="btn-river">Compartir Link</button>
        </div>
        <div style={{ marginTop: 24, paddingTop: 18, borderTop: '1px solid rgba(255,255,255,0.08)', textAlign: 'center', fontSize: '0.6rem', color: 'rgba(255,255,255,0.2)', letterSpacing: 1 }}>
          © 2026 Club Atlético River Plate — Comisión de la Juventud. Todos los derechos reservados.
        </div>
      </div>
    </footer>
  );
}

// ═══ APP ═══
function App() {
  const [page,    setPage]    = useState('inicio');
  const [events,  setEvents]  = useState([]);
  const [notes,   setNotes]   = useState({});
  const [loading, setLoading] = useState(true);
  const [msg,     setMsg]     = useState('');
  const [synced,  setSynced]  = useState(false);

  const reload = useCallback(() => {
    return dbLoad().then(({ events: evs, notes: ns }) => {
      setEvents(evs);
      setNotes(ns);
      setSynced(HAS_SB);
    });
  }, []);

  useEffect(() => {
    reload().finally(() => setLoading(false));
    if (HAS_SB) {
      const interval = setInterval(reload, 15000);
      return () => clearInterval(interval);
    }
  }, [reload]);

  const addEvent = async (payload) => {
    try {
      const newEv = await dbAddEvent(payload);
      const updated = [...events, newEv];
      setEvents(updated);
      lsSave(updated, notes);
    } catch(err) {
      const newEv = { ...payload, id: `ev_${Date.now()}` };
      const updated = [...events, newEv];
      setEvents(updated);
      lsSave(updated, notes);
      setMsg('Error Supabase: ' + (err?.message || JSON.stringify(err)));
      setTimeout(() => setMsg(''), 8000);
    }
  };

  const removeEvent = async (id) => {
    try { await dbRemoveEvent(id); } catch(err) { console.error('removeEvent error:', err); }
    const updated = events.filter(e => e.id !== id);
    setEvents(updated);
    lsSave(updated, notes);
  };

  const saveNote = async (eventId, content) => {
    try { await dbSaveNote(eventId, content, notes[eventId]); } catch(err) { console.error('saveNote error:', err); }
    const updatedNotes = { ...notes, [eventId]: { content } };
    setNotes(updatedNotes);
    lsSave(events, updatedNotes);
  };

  const scrollTo = (id) => {
    setPage(id);
    if (id !== 'inicio') setTimeout(() => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }), 80);
    else window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const share = async () => {
    const url = window.location.href;
    try {
      if (navigator.share) await navigator.share({ title: 'Comisión de la Juventud - River', url });
      else { await navigator.clipboard.writeText(url); setMsg('Link copiado!'); setTimeout(() => setMsg(''), 3000); }
    } catch { try { await navigator.clipboard.writeText(url); setMsg('Link copiado!'); setTimeout(() => setMsg(''), 3000); } catch { prompt('Copiá:', url); } }
  };

  if (loading) return (
    <div style={{ minHeight: '100vh', background: C.dark, display: 'flex', alignItems: 'center', justifyContent: 'center', flexDirection: 'column', gap: 18 }}>
      <div style={{ width: 56, height: 56, borderRadius: '50%', background: C.red, display: 'flex', alignItems: 'center', justifyContent: 'center', fontFamily: "'Oswald', sans-serif", fontWeight: 800, fontSize: '1.1rem', color: '#fff' }}>CJ</div>
      <div style={{ fontFamily: "'Roboto', sans-serif", fontSize: '0.7rem', color: 'rgba(255,255,255,0.35)', letterSpacing: 3, textTransform: 'uppercase' }}>Cargando...</div>
    </div>
  );

  return (
    <div style={{ fontFamily: "'Roboto', sans-serif", background: '#F4F4F4', minHeight: '100vh' }}>
      <Nav active={page} onNav={scrollTo} synced={synced} />
      <Hero onNav={scrollTo} />
      <Cal events={events} addEvent={addEvent} removeEvent={removeEvent} />
      <Areas events={events} notes={notes} saveNote={saveNote} />
      <Inst />
      <Footer onShare={share} />
      <MobileNav active={page} onNav={scrollTo} />
      {msg && (
        <div style={{ position: 'fixed', bottom: 80, left: '50%', transform: 'translateX(-50%)', background: C.dark, color: '#fff', padding: '11px 22px', borderRadius: 3, fontSize: '0.78rem', fontWeight: 600, zIndex: 300, boxShadow: '0 4px 18px rgba(0,0,0,0.3)', borderLeft: `4px solid ${C.red}`, whiteSpace: 'nowrap' }}>{msg}</div>
      )}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
